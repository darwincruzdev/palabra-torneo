{
  "expo": {
    "name": "Palabra Torneo",
    "slug": "palabra-torneo",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "palabratorneo",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0f1115",
    "primaryColor": "#3aa757",
    "splash": {
      "backgroundColor": "#0f1115",
      "resizeMode": "contain",
      "image": "./assets/splash-icon.png"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.darwincruz.palabratorneo"
    },
    "android": {
      "package": "com.darwincruz.palabratorneo",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0f1115",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Palabra Torneo",
      "shortName": "Palabra Torneo",
      "description": "Adivina la palabra del día y compite con los tuyos.",
      "themeColor": "#0f1115",
      "backgroundColor": "#0f1115",
      "display": "standalone",
      "orientation": "portrait",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-web-browser",
      "@react-native-google-signin/google-signin",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "92939758-2c64-4c8e-89bc-6a95f4865ffa"
      }
    },
    "owner": "orionis"
  }
}
