rules_version = '2';

// Reglas de seguridad de Palabra Torneo.
// Súbelas desde la consola de Firebase (Firestore > Reglas) o con la CLI:
//   firebase deploy --only firestore:rules
//
// Lo que más importa aquí: el documento de un torneo lleva su semilla, y con
// la semilla se puede calcular la palabra de cualquier día. Por eso el torneo
// sólo lo pueden leer sus miembros, y la invitación vive en otra colección.
service cloud.firestore {
  match /databases/{database}/documents {

    function conSesion() {
      return request.auth != null;
    }

    function datosTorneo(torneoId) {
      return get(/databases/$(database)/documents/torneos/$(torneoId)).data;
    }

    function esMiembro(torneoId) {
      return conSesion() && request.auth.uid in datosTorneo(torneoId).miembros;
    }

    function camposTocados() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Perfil público: nombre, avatar y título que se ven en las clasificaciones.
    //
    // El título y los avatares especiales se ganan con copas, y **eso el
    // servidor no lo puede comprobar**: contar copas pide todos los días de
    // todos sus torneos —cientos de documentos— y aquí caben diez lecturas por
    // evaluación. No es una decisión de diseño, es que no entra.
    //
    // Así que lo que se cierra aquí es la forma: que el título sea uno de los
    // que existen y que el avatar especial sea un índice y no un objeto. Que le
    // corresponda lo comprueba la app al pintarlo, en `rangos.ts`, y lo que no
    // le toque se le cae al avatar normal y sin título.
    //
    // El `is string` no es adorno: sin él, la última comparación se ejecuta con
    // un valor nulo —que es lo que lleva todo el que aún no ha ganado ningún
    // título, o sea casi todos— y en estas reglas un `in` sobre algo que no es
    // una cadena no da falso: da error, y un error aquí deniega. Se quedó medio
    // torneo sin poder guardar el perfil por esto.
    function tituloCreible() {
      return !('titulo' in request.resource.data)
        || request.resource.data.titulo == null
        || (request.resource.data.titulo is string
            && request.resource.data.titulo in
                 ['leyenda', 'senor', 'azote', 'emperador', 'indiscutible']);
    }

    // El índice no se acota por arriba a propósito: la lista de avatares crece
    // con el tiempo, y una cota aquí obligaría a desplegar las reglas cada vez
    // que se añade uno o los perfiles nuevos dejarían de guardarse. Pasarse de
    // largo no hace daño —`normalizarAvatar` quita el que no existe—; dejar de
    // poder guardar sí lo haría.
    // Lo mismo con el `is map`: preguntar `'especial' in algo` que no sea un
    // mapa también es un error, no un falso.
    function avatarCreible() {
      return !('avatar' in request.resource.data)
        || !(request.resource.data.avatar is map)
        || !('especial' in request.resource.data.avatar)
        || (request.resource.data.avatar.especial is int
            && request.resource.data.avatar.especial >= 0);
    }

    // Las copas guardadas son una caché para el arranque, no la verdad: la
    // verdad es el palmarés y se recalcula en cuanto hay historial. Aquí sólo
    // se cierra que sea un número, para que no llegue cualquier cosa.
    function cuentasCreibles() {
      return (!('copas' in request.resource.data)
          || (request.resource.data.copas is int && request.resource.data.copas >= 0))
        && (!('rangosAvisados' in request.resource.data)
          || (request.resource.data.rangosAvisados is int
              && request.resource.data.rangosAvisados >= 0));
    }

    match /usuarios/{uid} {
      allow read: if conSesion();
      allow write: if conSesion() && request.auth.uid == uid
        && tituloCreible()
        && avatarCreible()
        && cuentasCreibles();
    }

    // Invitaciones. Cualquiera con sesión puede resolver un código, que es lo
    // que hace falta para unirse. Aquí NO va la semilla: sólo el id y el
    // nombre del torneo.
    match /codigos/{codigo} {
      allow read: if conSesion();
      allow create: if conSesion()
        && request.resource.data.keys().hasOnly(['codigo', 'torneoId', 'nombre'])
        && request.resource.data.codigo == codigo;
      // Un código no se reescribe: si hiciera falta cambiarlo, se borra y se
      // crea otro. Así nadie puede secuestrar el código de un torneo ajeno.
      allow update: if false;
      allow delete: if conSesion()
        && request.auth.uid == datosTorneo(request.resource.data.torneoId).propietario;
    }

    // Invitaciones a duelos. Como las de los torneos: se pueden resolver sin ser
    // participante, y no llevan la semilla.
    match /codigosDuelo/{codigo} {
      allow read: if conSesion();
      allow create: if conSesion()
        && request.resource.data.keys().hasOnly(['codigo', 'dueloId', 'retador'])
        && request.resource.data.codigo == codigo
        && request.resource.data.retador == request.auth.uid;
      allow update: if false;
      allow delete: if conSesion() && resource.data.retador == request.auth.uid;
    }

    match /duelos/{dueloId} {
      // Los participantes, y además quien llega con una invitación a un duelo
      // que todavía busca rival: para poder entrar hay que leer antes el
      // documento, y en ese momento aún no figuras entre los jugadores.
      //
      // Un duelo a la espera no tiene nada que proteger: no hay puntuaciones, y
      // la semilla se la va a quedar de todas formas al entrar.
      allow get: if conSesion() && (
        request.auth.uid in resource.data.jugadores
        || resource.data.rival == null
      );
      // Listar: los propios, y además los de la cola, que es como se encuentra
      // rival sin pasarse un código. Un duelo de cola no tiene nada que
      // proteger —ni puntuaciones ni rival— y su semilla se la iba a quedar
      // igualmente quien entre.
      allow list: if conSesion() && (
        request.auth.uid in resource.data.jugadores
        || (resource.data.abierto == true && resource.data.rival == null)
      );

      allow create: if conSesion()
        && request.resource.data.retador.uid == request.auth.uid
        && request.resource.data.jugadores == [request.auth.uid]
        && request.resource.data.estado == 'esperando';

      allow update: if conSesion() && (
        (
          // Entrar como rival: sólo si el sitio está libre y me apunto a mí.
          resource.data.rival == null
          && request.resource.data.rival.uid == request.auth.uid
          && request.resource.data.jugadores.hasAll(resource.data.jugadores)
          && request.resource.data.jugadores.size() == 2
        )
        || (
          // Ya dentro: mi propio progreso, mis pullas, el cierre del duelo y
          // proponer la revancha.
          request.auth.uid in resource.data.jugadores
          && camposTocados().hasOnly(['progreso', 'estado', 'pullas', 'revancha'])
          && (
            !camposTocados().hasAny(['progreso'])
            || request.resource.data.progreso.diff(resource.data.progreso)
                 .affectedKeys().hasOnly([request.auth.uid])
          )
          && (
            !camposTocados().hasAny(['pullas'])
            || request.resource.data.pullas.diff(resource.data.get('pullas', {}))
                 .affectedKeys().hasOnly([request.auth.uid])
          )
        )
      );

      allow delete: if conSesion() && resource.data.retador.uid == request.auth.uid;
    }

    match /torneos/{torneoId} {
      // Sólo los miembros. Quien no lo sea no puede leer la semilla, y por
      // tanto no puede calcular la palabra del día de este torneo.
      allow get: if esMiembro(torneoId);
      allow list: if conSesion() && request.auth.uid in resource.data.miembros;

      // Al crear, el fundador es el único miembro.
      allow create: if conSesion()
        && request.resource.data.propietario == request.auth.uid
        && request.resource.data.miembros == [request.auth.uid];

      allow update: if conSesion() && (
        (
          // Entrar o salir: el único cambio permitido en la lista de miembros
          // es el propio uid, y de paso se deja el perfil con el que se entra.
          camposTocados().hasOnly(['miembros', 'perfiles'])
          && request.resource.data.miembros.toSet()
               .difference(resource.data.miembros.toSet()).hasOnly([request.auth.uid])
          && resource.data.miembros.toSet()
               .difference(request.resource.data.miembros.toSet()).hasOnly([request.auth.uid])
        )
        || (
          // Cambiar mi nombre o mi avatar dentro del torneo.
          camposTocados().hasOnly(['perfiles'])
          && request.resource.data.perfiles.diff(resource.data.perfiles)
               .affectedKeys().hasOnly([request.auth.uid])
        )
        || (
          // El fundador pone el nombre, decide las normas de la casa y puede
          // reiniciar la competición moviendo la fecha de fundación. La
          // semilla no se toca nunca. Las puntuaciones no se tocan desde
          // ningún sitio: es lo que hace que nadie pueda hacer trampas.
          resource.data.propietario == request.auth.uid
          && camposTocados().hasOnly(['nombre', 'reglas', 'fechaInicio', 'desempates'])
        )
      );

      allow delete: if conSesion() && resource.data.propietario == request.auth.uid;

      // Una jornada = un documento con cuatro mapas: los resultados, las
      // blueshells que caen ese día, quién gastó su protección y quién gastó su
      // ulti. Los cuatro van indexados por uid, y de cada uno sólo se puede
      // tocar la casilla propia.
      match /dias/{fecha} {
        allow read: if esMiembro(torneoId);

        // El `get` con valor por defecto es necesario porque un documento puede
        // no traer todavía un mapa: una blueshell disparada contra mañana crea
        // la jornada cuando aún no hay resultados de nadie.
        function soloMio(campo) {
          return request.resource.data.get(campo, {}).keys().hasOnly([request.auth.uid]);
        }

        function soloCambioMio(campo) {
          return request.resource.data.get(campo, {})
                   .diff(resource.data.get(campo, {}))
                   .affectedKeys().hasOnly([request.auth.uid]);
        }

        // La ulti: una palabra, y nada más.
        function ultiCreible() {
          return request.resource.data.ultis[request.auth.uid].palabra
                   .matches('^[a-zñ]{5,10}$');
        }

        // Una ulti por jornada en todo el torneo, y escrita una sola vez.
        //
        // Esto sí lo puede sostener el servidor, y hace falta que lo sostenga.
        // La app no deja gastarla si ya hay una, pero dos personas pueden pulsar
        // a la vez desde dos móviles y ninguna de las dos lo sabría: aquí la
        // segunda se encuentra el mapa con una casilla que no es la suya y el
        // `hasOnly` la rechaza. Gana quien llegue primero, de verdad.
        //
        // Y sin `primeraUlti` se podría reescribir la propia a media mañana,
        // con medio torneo ya jugando: cambiarle la palabra a los que no han
        // empezado sería peor que ponerla. Una vez puesta, no se toca.
        function unicaUlti() {
          return request.resource.data.get('ultis', {})
                   .keys().hasOnly([request.auth.uid]);
        }

        function primeraUlti() {
          return !resource.data.get('ultis', {}).keys().hasAny([request.auth.uid]);
        }

        // Una bala tiene que llevar algo que pueda ser una palabra y, si trae
        // víctima escrita, que sea alguien del torneo.
        //
        // La víctima ya no se guarda: desde el parche del cierre de jornada la
        // bala va "al que termine primero" y eso lo calcula cada móvil de la
        // clasificación. Por eso el campo es opcional aquí — las balas viejas
        // lo traen y se siguen respetando, las nuevas llegan sin él.
        //
        // El servidor no tiene el diccionario, así que no puede comprobar que
        // la palabra exista de verdad —de eso se encarga la app, que ignora las
        // balas con palabras inventadas—, pero sí puede cerrar lo burdo: meter
        // cifras y símbolos donde va una palabra.
        //
        // El margen de 5 a 10 es a propósito: la Ñ ocupa dos bytes y no está
        // claro si aquí se cuenta por letras o por bytes. Pasarse de largo no
        // hace daño —la app filtra igual—; rechazar "aceña" sí lo haría.
        function balaCreible() {
          return request.resource.data.blueshells[request.auth.uid].palabra
                   .matches('^[a-zñ]{5,10}$')
            && (!('objetivo' in request.resource.data.blueshells[request.auth.uid])
                || request.resource.data.blueshells[request.auth.uid].objetivo
                     in datosTorneo(torneoId).miembros);
        }

        // El resultado de una jornada se escribe una vez y no se toca más.
        //
        // Sin esto, entrar con la misma cuenta desde otro navegador dejaba
        // volver a jugar la palabra —el móvil no sabía que ya estaba hecha— y
        // pisar la puntuación anterior. Entrar con Google dice quién eres; esto
        // es lo que impide que te repitas la jornada hasta que salga bien.
        function primerResultado() {
          return !resource.data.get('resultados', {}).keys().hasAny([request.auth.uid]);
        }

        // Cada jugador sólo puede escribir su propia casilla de cada mapa, así
        // que nadie puede inflarse los puntos, disparar en nombre de otro ni
        // quitarle la protección a nadie.
        allow create: if esMiembro(torneoId)
          && request.resource.data.keys()
               .hasOnly(['fecha', 'resultados', 'blueshells', 'protecciones', 'ultis'])
          && soloMio('resultados')
          && soloMio('blueshells')
          && soloMio('protecciones')
          && soloMio('ultis')
          && (!request.resource.data.keys().hasAny(['blueshells']) || balaCreible())
          && (!request.resource.data.keys().hasAny(['ultis'])
              || (ultiCreible() && unicaUlti()));

        allow update: if esMiembro(torneoId)
          && camposTocados().hasOnly(['resultados', 'blueshells', 'protecciones', 'ultis'])
          && soloCambioMio('resultados')
          && soloCambioMio('blueshells')
          && soloCambioMio('protecciones')
          && soloCambioMio('ultis')
          && (!camposTocados().hasAny(['resultados']) || primerResultado())
          && (!camposTocados().hasAny(['blueshells']) || balaCreible())
          && (!camposTocados().hasAny(['ultis'])
              || (ultiCreible() && unicaUlti() && primeraUlti()));

        allow delete: if false;
      }
    }
  }
}
