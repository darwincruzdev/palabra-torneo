# Copia este fichero a .env y rellénalo. Las variables se leen al compilar, así
# que después de tocarlas hay que reiniciar el servidor.

# --- Firebase -----------------------------------------------------------
# Consola de Firebase > Configuración del proyecto > Tus apps > App web
#
# No son secretos: la clave de API sólo identifica al proyecto. Lo que protege
# los datos son las reglas de firestore.rules.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# --- Entrar con Google --------------------------------------------------
# Google Cloud Console > APIs y servicios > Credenciales > ID de cliente OAuth.
# Hacen falta dos: uno de tipo "Aplicación web" (es el que valida Firebase, y
# es obligatorio) y uno de tipo "Android", con el nombre del paquete
# com.darwincruz.palabratorneo y la huella SHA-1 de tu clave de firma.
#
# La huella la da EAS:  eas credentials

EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# --- Invitaciones -------------------------------------------------------
# Dirección donde está publicada la web, sin barra final. De aquí sale el
# enlace que se manda por WhatsApp y el contenido de los códigos QR.
# Si lo dejas vacío, se reparte el código de seis caracteres a secas.

EXPO_PUBLIC_URL_BASE=https://palabra-torneo.pages.dev
